# Supabase (server-side only — used by the contact form Server Action)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email notifications for new contact form submissions)
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# Analytics (optional — leave blank to disable)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# OmniRoute AI Gateway (Chatbot Assistant — Server-Side Only)
OMNIROUTE_API_URL="https://api.omniroute.ai/v1"
OMNIROUTE_API_KEY=""
OMNIROUTE_MODEL="gpt-4o-mini"
